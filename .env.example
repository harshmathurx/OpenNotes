# Remote storage providers (e.g. Dropbox, folder sync) are visible by default.
# Set this to false only for builds that should be strictly local-only.
NEXT_PUBLIC_ENABLE_REMOTE_STORAGE=true

# OpenNotes never custodies a secret. Git sync (Mac app) uses your local git
# and SSH/agent credentials; AI keys are entered by you and stored encrypted
# on device (AES-GCM-256). Do not commit keys or tokens.
