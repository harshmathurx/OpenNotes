# Remote storage is hidden unless explicitly enabled.
NEXT_PUBLIC_ENABLE_REMOTE_STORAGE=false

# Optional GitHub OAuth app settings for /api/auth/github/start and callback.
# Do not expose the client secret to the browser.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
